# Python bytecode and build output
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
/env/
.python-version-local

# Test, lint and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local application caches (LLM response cache lives under ~/.cache, fallback .cache/llm)
.cache/

# Secrets and local configuration: never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Local databases and dumps
*.db
*.sqlite
*.sqlite3
*.dump

# Editor and OS files
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
mutants/

# QASPER source PDFs/raw dumps (88 MB); rebuild with scripts/build_qasper_gold.py
evals/qasper/pdfs/
evals/qasper/raw/

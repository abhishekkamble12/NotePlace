# Copy to .env (git-ignored). Placeholders only: never commit real values.
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key
BRAVE_API_KEY=your-brave-api-key

# Secret for Stage 2 prompt delimiters (HMAC). REQUIRED: API, worker and MCP server refuse to start without it.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# See docs/EVIDENCE_HMAC_KEY.md
CITEGUARD_EVIDENCE_HMAC_KEY=replace-with-64-hex-chars-from-the-command-above

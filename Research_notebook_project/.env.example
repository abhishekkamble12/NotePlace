# Copy to .env (git-ignored). Placeholders only: never commit real values.
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key
BRAVE_API_KEY=your-brave-api-key

# Secret for Stage 2 prompt delimiters (HMAC). REQUIRED: the API and the MCP server refuse to start without it.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# See docs/EVIDENCE_HMAC_KEY.md
CITEGUARD_EVIDENCE_HMAC_KEY=replace-with-64-hex-chars-from-the-command-above

# Notebook/chat auth (dev only, until Cognito): comma-separated token:subject pairs. Unset = every notebook call is 401.
CITEGUARD_DEV_TOKENS=
# Rolling 24 h token cap per user across all conversations (default 200000).
CITEGUARD_USER_DAILY_TOKENS=
# Abstain before calling the model if the best reranked chunk scores below this. Unset = off (see RESULTS.md).
CITEGUARD_ABSTAIN_MIN_RERANK_SCORE=   # leave unset: E6a found this gate near chance (AUROC 0.60 on test), RESULTS.md section 5
